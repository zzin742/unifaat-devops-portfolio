#!/bin/bash
# Bootstrap da EC2 da API. Log completo em /var/log/user-data.log.
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

dnf update -y
dnf install -y docker postgresql16

systemctl enable --now docker
usermod -aG docker ec2-user

# Credenciais do RDS gravadas com permissao restrita — o arquivo carrega a senha.
cat > /etc/technova.env <<ENVFILE
ENVIRONMENT=${environment}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
ENVFILE
chmod 600 /etc/technova.env

# Prova de que a EC2 alcanca o RDS pela subnet privada. Se o Security Group
# estiver errado, este comando falha e o erro fica registrado no log.
set +e
PGPASSWORD='${db_password}' psql \
  -h ${db_host} -p ${db_port} -U ${db_user} -d ${db_name} \
  -c 'SELECT version();' > /var/log/rds-conexao.log 2>&1
echo "psql saiu com codigo $?" >> /var/log/rds-conexao.log
set -e

echo "bootstrap do ambiente ${environment} concluido em $(date -Is)"
